# Database credentials
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# Base64-encoded 32-byte AES key
ENCRYPTION_KEY=

# Bootstrap admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base64-encoded JWT signing key
JWT_SECRET_KEY=

# OAuth2 providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# TMDB API bearer token
TMDB_ACCESS_TOKEN=

# Swagger / OpenAPI base path (must not be empty)
API_DOCS_BASE_URL=/docs

# Frontends URLs
FRONTEND_MGMT_URL=
FRONTEND_CLIENT_URL=

# Frontend apps ports
MANAGEMENT_PORT=
CLIENT_PORT=

# Backend app port
SERVER_PORT=

# Docker image versions
CINEFY_NGINX_VERSION=
CINEFY_BACKEND_VERSION=
CINEFY_MANAGEMENT_VERSION=
CINEFY_CLIENT_VERSION=