# Values are filled in for the local stack (docker-compose.local.yml).
# Blank values are secrets you must supply. Replace everything for production.

# Database credentials
DATABASE_HOST=cinefy-db:5432
DATABASE_NAME=cinefydb
DATABASE_USERNAME=cinefy
DATABASE_PASSWORD=cinefy

# Redis credentials (REDIS_HOST is host:port; URL-encode special characters in the password)
REDIS_HOST=cinefy-redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# Base64-encoded 32-byte AES key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Bootstrap admin account
ADMIN_EMAIL=admin@cinefy.local
ADMIN_PASSWORD=

# Base64-encoded JWT signing key (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=

# OAuth2 providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# TMDB API bearer token
TMDB_ACCESS_TOKEN=

# Swagger / OpenAPI base path (must not be empty)
API_DOCS_BASE_URL=/docs

# Frontends URLs
FRONTEND_MGMT_URL=http://localhost:4200
FRONTEND_CLIENT_URL=http://localhost

# Host names the client site accepts (comma-separated)
FRONTEND_CLIENT_ALLOWED_HOSTS=localhost

# Frontend apps ports
MANAGEMENT_PORT=80
CLIENT_PORT=4000

# Backend app port
SERVER_PORT=8080

# Docker image versions
CINEFY_NGINX_VERSION=latest
CINEFY_BACKEND_VERSION=latest
CINEFY_MANAGEMENT_VERSION=latest
CINEFY_CLIENT_VERSION=latest
