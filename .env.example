# Database (shared by the backend and the postgres container)
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Gmail SMTP
MAIL_USERNAME=
MAIL_PASSWORD=

# Base64-encoded 32-byte AES key
ENCRYPTION_KEY=

# Bootstrap admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base64-encoded JWT signing key
JWT_SECRET_KEY=

# OAuth2 providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Frontends URLs
FRONTEND_MGMT_URL=
FRONTEND_CLIENT_URL=

# TMDB API bearer token
TMDB_ACCESS_TOKEN=

# Port the backend listens on
SERVER_PORT=

# Port the client SSR server listens on
CLIENT_PORT=
